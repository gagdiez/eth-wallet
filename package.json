{
  "name": "ethereum-near-connect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:executor && concurrently --kill-others --names wallet,example \"npm:dev:wallet\" \"npm:dev:example\"",
    "dev:wallet": "vite --host 127.0.0.1",
    "dev:example": "vite --config example/vite.config.ts --host 127.0.0.1",
    "build:example": "npm run typecheck && vite build --config example/vite.config.ts",
    "build:executor": "esbuild src/executor.ts --bundle --format=esm --outfile=public/executor.js",
    "build": "npm run typecheck && npm run build:executor && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.11.4",
    "@reown/appkit": "^1.8.19",
    "@reown/appkit-adapter-ethers": "^1.8.19",
    "@scure/base": "^2.0.0",
    "ethers": "^6.17.0",
    "viem": "^2.47.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.2",
    "vitest": "^3.2.0"
  }
}
